{
  "name": "chess-review",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:engine": "bash scripts/dev-with-engine.sh",
    "eval-server": "node stockfish-server.mjs",
    "eval-server:public": "STOCKFISH_BIND=0.0.0.0 node stockfish-server.mjs",
    "laptop:server": "bash scripts/run-laptop-server.sh",
    "laptop:start": "bash scripts/start-laptop-bg.sh",
    "laptop:stop": "bash scripts/stop-laptop-bg.sh",
    "expose-engine": "bash scripts/expose-engine.sh",
    "check-engine": "bash scripts/check-engine.sh",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@vercel/analytics": "^2.0.1",
    "chess.js": "^1.3.0",
    "react": "^18.3.1",
    "react-chessboard": "^4.7.2",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "stockfish.js": "^10.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2.1.8"
  }
}
