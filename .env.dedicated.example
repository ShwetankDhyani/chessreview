# Copy to .env on a dedicated-ish host (16GB+ RAM recommended).
# Full-depth reviews: every position at requested depth, parallel workers.

STOCKFISH_PATH=/usr/bin/stockfish
STOCKFISH_DEDICATED=1
STOCKFISH_LAPTOP_MODE=0

# Oracle 4 OCPU / ~23GB example — parallel FENs without oversubscribing cores:
STOCKFISH_WORKERS=2
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=1024

STOCKFISH_CACHE_SIZE=8192
STOCKFISH_MAX_BATCH=128
STOCKFISH_EVAL_TIMEOUT_MS=90000

# Review counter (saved to data/review-stats.json on this machine)
STATS_REVIEWS_BASELINE=0
ADMIN_SECRET=change-me

# Do NOT set STOCKFISH_MOVETIME_MS
