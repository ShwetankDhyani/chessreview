# Copy to .env on your Fedora laptop (i5 8th gen, 8 GB RAM, mostly a Stockfish server).
# Maximizes strength per analysis while leaving room for GNOME + tunnel + Node.

STOCKFISH_PATH=/usr/bin/stockfish
STOCKFISH_DEDICATED=1
STOCKFISH_LAPTOP_MODE=0
STOCKFISH_THREADS=3
STOCKFISH_HASH_MB=384
STOCKFISH_CACHE_SIZE=8192
STOCKFISH_MAX_BATCH=128
STOCKFISH_EVAL_TIMEOUT_MS=60000

# Do NOT set STOCKFISH_MOVETIME_MS — use full depth from the site (16 recommended).
