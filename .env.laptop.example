# Copy to .env on your Stockfish laptop (sourced by npm run laptop:server)
#
# STOCKFISH_LAPTOP_MODE=1 is the default — conservative threads/RAM for old hardware.

STOCKFISH_PATH=/usr/bin/stockfish
STOCKFISH_LAPTOP_MODE=1
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=128
STOCKFISH_CACHE_SIZE=8192
STOCKFISH_MAX_BATCH=128
STOCKFISH_EVAL_TIMEOUT_MS=45000

# Optional: fixed time per position instead of depth (e.g. 800ms — fast reviews)
# STOCKFISH_MOVETIME_MS=800
