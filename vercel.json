{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "chessreview.org" }],
      "destination": "https://www.chessreview.org/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|svg|png|jpg|jpeg|webp|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/stats/public",
      "destination": "/api/stats?kind=public"
    },
    {
      "source": "/api/stats/admin",
      "destination": "/api/stats?kind=admin"
    },
    {
      "source": "/api/stats/timing",
      "destination": "/api/stats?kind=timing"
    },
    {
      "source": "/api/share-preview",
      "destination": "/api/share?preview=1"
    },
    {
      "source": "/api/blog-media/:id",
      "destination": "/api/blog?media=:id"
    },
    {
      "source": "/api/blog/:slug",
      "destination": "/api/blog?slug=:slug"
    },
    {
      "source": "/api/sitemap",
      "destination": "/api/blog?sitemap=1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/blog?sitemap=1"
    },
    {
      "source": "/r/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawl|spider|facebook|twitter|slack|discord|telegram|linkedin|whatsapp|preview).*"
        }
      ],
      "destination": "/api/share?preview=1&id=:id"
    },
    {
      "source": "/blog",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawl|spider|facebook|twitter|slack|discord|telegram|linkedin|whatsapp|preview|google|bing|yandex|duckduck).*"
        }
      ],
      "destination": "/api/blog?format=html"
    },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawl|spider|facebook|twitter|slack|discord|telegram|linkedin|whatsapp|preview|google|bing|yandex|duckduck).*"
        }
      ],
      "destination": "/api/blog?slug=:slug&format=html"
    },
    {
      "source": "/about",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawl|spider|facebook|twitter|slack|discord|telegram|linkedin|whatsapp|preview|google|bing|yandex|duckduck).*"
        }
      ],
      "destination": "/about-crawler.html"
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawl|spider|facebook|twitter|slack|discord|telegram|linkedin|whatsapp|preview|google|bing|yandex|duckduck).*"
        }
      ],
      "destination": "/privacy-crawler.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
