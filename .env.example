# Optional: Gemini API for AI coach commentary
VITE_GEMINI_API_KEY=

# Native Stockfish (laptop server for Vercel — depth 16, full-game analysis)
# STOCKFISH_PATH=/home/you/.local/bin/stockfish
# STOCKFISH_THREADS=7
# STOCKFISH_HASH_MB=512

# Laptop + Vercel workflow:
# 1) npm run laptop:server        (keep terminal open; copy https tunnel URL)
# 2) Vercel → VITE_EVAL_SERVER_URL=<tunnel URL> → Redeploy
# VITE_EVAL_SERVER_URL=https://your-tunnel.trycloudflare.com

# Review analytics — stored on your engine server (see supabase/SETUP.md)
# EVAL_SERVER_URL=https://your-tunnel.trycloudflare.com
# ADMIN_SECRET=your-admin-password
# STATS_REVIEWS_BASELINE=120

# Optional legacy Supabase (not required):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: support links in Help popup (JSON array, redeploy after change)
# VITE_SUPPORT_LINKS=[{"label":"Support via PayPal","href":"https://paypal.me/shwetankdhyani"}]
